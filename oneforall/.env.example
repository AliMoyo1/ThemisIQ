# ThemisIQ — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── App ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
HOST=127.0.0.1
PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — local dev only):
DB_PATH=data/oneforall.db

# PostgreSQL (production — set DATABASE_URL to switch engines):
# DATABASE_URL=postgresql://themisiq@pgbouncer:5432/themisiq
# PGPASSWORD_FILE=/run/secrets/pg_password   # preferred over inline password
# PGSSLMODE=require                          # enforce TLS on private bridge
# POSTGRES_POOL_MIN=2
# POSTGRES_POOL_MAX=10

# Backup (used by the 02:00 CAT scheduled backup job):
# BACKUP_PATH=data/backups
# BACKUP_RETAIN_DAYS=30
# BACKUP_OFFSITE_RCLONE_REMOTE=r2:themisiq-backups   # Cloudflare R2 via rclone

# ── AI Provider (choose one) ──────────────────────────────────────────────────
AI_PROVIDER=openrouter

# OpenRouter (recommended production profile)
# Use a dedicated key with a hard monthly budget in the OpenRouter dashboard.
# The paid, exact slug avoids free-tier rate limits and auto/latest model drift.
# Keep ZDR and data_collection=deny for GRC data; requests fail rather than
# silently route to an endpoint that does not satisfy those privacy controls.
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_SITE_URL=https://app.themisiq.net
OPENROUTER_APP_NAME=ThemisIQ
OPENROUTER_REQUIRE_EXACT_MODEL=true
OPENROUTER_ZDR=true
OPENROUTER_DATA_COLLECTION=deny
# Hard USD ceiling per 1M tokens; requests fail if no endpoint qualifies.
OPENROUTER_MAX_INPUT_PRICE_PER_M=0.25
OPENROUTER_MAX_OUTPUT_PRICE_PER_M=0.75

# ERM grounded horizon scanning uses OpenRouter's server-side web search.
# Exa supports the authoritative-domain allowlist configured in config.py.
OPENROUTER_WEB_SEARCH_ENGINE=exa
OPENROUTER_WEB_SEARCH_MAX_RESULTS=5
OPENROUTER_WEB_SEARCH_MAX_TOTAL_RESULTS=15

# Anthropic (optional alternative)
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI (optional)
# OPENAI_API_KEY=sk-your-key-here

# Google Gemini (optional)
# GEMINI_API_KEY=your-key-here

# DeepSeek (optional)
# DEEPSEEK_API_KEY=your-key-here

# Ollama (optional — local LLM, no key needed)
# OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434

# ── Email (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=ThemisIQ <noreply@yourdomain.com>

# ── PLAN-35: ARIA policy authoring workflow (disabled by default) ─────────────
# Leave ARIA_POLICY_AUTHORING_ENABLED=false until the release gates in
# plans/PLAN-35-aria-policy-authoring-flow.md section 15 all pass, including
# a real converter test and a dedicated PostgreSQL run. Even when true,
# ARIA_POLICY_AUTHORING_ORG_IDS empty enables it for no tenant -- authoring
# is an explicit per-org allowlist, not a blanket switch.
ARIA_POLICY_AUTHORING_ENABLED=false
# ARIA_POLICY_AUTHORING_ORG_IDS=1,2

# Spool directory shared with the aria-preview converter container. Use the
# root docker-compose.yml for a full local stack; on the systemd VPS use
# deploy/aria-preview/compose.vps.yml and set the same absolute host directory
# in the service and companion environments. The converter executable itself
# is that container's own ARIA_POLICY_PREVIEW_EXECUTABLE setting, never this
# app's.
# ARIA_POLICY_PREVIEW_SPOOL_DIR=data/aria_preview_spool
# ARIA_POLICY_PREVIEW_TIMEOUT_SECONDS=60
# ARIA_POLICY_DRAFT_EXPIRY_DAYS=30
# ARIA_POLICY_ORPHAN_GRACE_HOURS=24
# ARIA_POLICY_TRASH_RETENTION_DAYS=7
